DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_documents
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SECRET_KEY=super_secret_key_change_me_in_production
# Через запятую, без "*" (вместе с credentials это запрещено)
CORS_ORIGINS=http://localhost,http://localhost:5173
OPENAI_API_KEY=sk-your-openai-api-key-here
# Для OpenAI-совместимых провайдеров (Gemini / OpenRouter / Ollama):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# Каталог для загруженных файлов (в Docker-контейнере это /app/storage)
UPLOAD_DIR=/app/storage

# --- OCR (Этапы 1-2) ---
# tesseract | vision (gpt-4o/gemini) | paddle (нужен paddleocr) | surya (заготовка)
# OCR_LANGUAGES=auto — определить язык по доле кириллицы (S5)
OCR_ENGINE=tesseract
OCR_LANGUAGES=rus+eng
OCR_MIN_CHARS_PER_PAGE=100
OCR_IMAGE_AREA_THRESHOLD=0.85
OCR_MAX_PAGES=500

# --- Загрузка / безопасность (S1) ---
MAX_UPLOAD_SIZE_MB=50
PARSE_TIMEOUT_SECONDS=300
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_SIDE_PX=20000
MAX_DOCUMENTS_PER_USER=100
MAX_STORAGE_BYTES_PER_USER=2147483648

# --- JWT / rate limiting (S1) ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute
CHAT_RATE_LIMIT=30/minute
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Embeddings / поиск (Этап 5) ---
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024
RERANK_TOP_K=50
RRF_K=60
# HNSW (миграция 0003)
USE_ANN_INDEX=true
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=80
EMBEDDING_CACHE_TTL_SECONDS=3600
CELERY_OCR_QUEUE=ocr
# Пул БД и лимит параллельных LLM-запросов
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
LLM_MAX_CONCURRENCY=4
# Опционально: включить PgBouncer (сервис уже в docker-compose.yml)
# DB_HOST=pgbouncer
# DB_PORT=6432

# --- Наблюдаемость (S2): пароль Grafana в docker-compose ---
GRAFANA_PASSWORD=admin

# --- T9: object storage и мультитенантность ---
# local (volume) или s3 (MinIO/AWS)
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=ai-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PRESIGN_TTL=300
RATE_LIMIT_REDIS=false
MULTITENANT_ENABLED=true
MAX_ORG_DOCUMENTS=1000
MAX_ORG_STORAGE_BYTES=21474836480

# --- T8: безопасная сессия и PII ---
# Для локального HTTP поставить false (иначе cookie не сохранятся)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CSRF_ENFORCE=true
PII_REDACTION_ENABLED=true
DEFAULT_USER_ROLE=editor
# AUDIT_WEBHOOK_URL=https://siem.example.com/audit
# SECRETS_PROVIDER=vault   # или aws; без значения используется env

# --- T7: онлайн-оценка RAG ---
RAG_EVAL_ENABLED=true
RAG_EVAL_SAMPLE_RATE=0.1
RAG_MIN_FAITHFULNESS=0.5
RAG_MIN_ANSWER_RELEVANCE=0.5

# --- T6: двуязычные документы и перевод ---
TRANSLATION_ENABLED=true
TRANSLATION_TARGET_LANGUAGE=ru
TRANSLATION_QUEUE=translation
TRANSLATION_MAX_CHARS_PER_REQUEST=4000
TRANSLATION_CACHE_TTL_SECONDS=86400
TRANSLATION_COST_LIMIT_USD=20.0
SUPPORTED_LANGUAGES=ru,en,de,fr,es

# --- S5: реранкинг, промпты, стоимость LLM ---
RERANK_ENABLED=true
# RERANK_MODEL=gemini-2.5-flash   # пусто = LLM_MODEL
PROMPT_VERSION=v1
LLM_COST_PER_1K_INPUT=0.0
LLM_COST_PER_1K_OUTPUT=0.0
LLM_MONTHLY_BUDGET_USD=100.0

# --- Retention (S4) ---
RETENTION_DAYS=365
SOFT_DELETE_GRACE_DAYS=7
SUMMARY_VERSIONS_KEEP=20
