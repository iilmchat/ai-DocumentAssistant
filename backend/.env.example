DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_documents
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SECRET_KEY=super_secret_key_change_me
OPENAI_API_KEY=sk-your-openai-api-key-here

# Каталог для загруженных файлов (в Docker-контейнере это /app/storage)
UPLOAD_DIR=/app/storage

# --- OCR (Этапы 1-2) ---
OCR_ENGINE=tesseract
OCR_LANGUAGES=rus+eng
OCR_MIN_CHARS_PER_PAGE=100
OCR_IMAGE_AREA_THRESHOLD=0.85
OCR_MAX_PAGES=500

# --- Загрузка / безопасность ---
MAX_UPLOAD_SIZE_MB=50
PARSE_TIMEOUT_SECONDS=300

# --- Embeddings / поиск (Этап 5) ---
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024
RERANK_TOP_K=50
RRF_K=60
CELERY_OCR_QUEUE=ocr
