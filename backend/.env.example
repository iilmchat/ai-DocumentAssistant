DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_documents
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SECRET_KEY=super_secret_key_change_me_in_production
# Через запятую, без "*" (вместе с credentials это запрещено)
CORS_ORIGINS=http://localhost,http://localhost:5173
OPENAI_API_KEY=sk-your-openai-api-key-here
# Для OpenAI-совместимых провайдеров (Gemini / OpenRouter / Ollama):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# Каталог для загруженных файлов (в Docker-контейнере это /app/storage)
UPLOAD_DIR=/app/storage

# --- OCR (Этапы 1-2) ---
# tesseract (baseline) или vision (gpt-4o / gemini по страницам PDF)
OCR_ENGINE=tesseract
OCR_LANGUAGES=rus+eng
OCR_MIN_CHARS_PER_PAGE=100
OCR_IMAGE_AREA_THRESHOLD=0.85
OCR_MAX_PAGES=500

# --- Загрузка / безопасность (S1) ---
MAX_UPLOAD_SIZE_MB=50
PARSE_TIMEOUT_SECONDS=300
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_SIDE_PX=20000
MAX_DOCUMENTS_PER_USER=100
MAX_STORAGE_BYTES_PER_USER=2147483648

# --- JWT / rate limiting (S1) ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute
CHAT_RATE_LIMIT=30/minute
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Embeddings / поиск (Этап 5) ---
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024
RERANK_TOP_K=50
RRF_K=60
# HNSW (миграция 0003)
USE_ANN_INDEX=true
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=80
EMBEDDING_CACHE_TTL_SECONDS=3600
CELERY_OCR_QUEUE=ocr
# Пул БД и лимит параллельных LLM-запросов
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
LLM_MAX_CONCURRENCY=4
# Опционально: включить PgBouncer (сервис уже в docker-compose.yml)
# DB_HOST=pgbouncer
# DB_PORT=6432

# --- Наблюдаемость (S2): пароль Grafana в docker-compose ---
GRAFANA_PASSWORD=admin
